{
    "sap.m.Tokenizer": {
        "prefix": "!5-sap-m-tokenizer",
        "body": [
            "<m:Tokenizer ",
            "\t$1",
            "\t/>"
        ],
        "description": "sap.m.Tokenizer"
    },
    "sap.m.Tokenizer-properties": {
        "prefix": "!5-sap-m-tokenizer",
        "body": [
            "<m:Tokenizer",
            "\teditable=\"true\"",
            "\tenabled=\"true\"",
            "\twidth=\"null\"",
            "\tmaxWidth=\"100%\"",
            "\trenderMode=\"sap.m.TokenizerRenderMode.Narrow\"",
            "$1/>"
        ],
        "description": "sap.m.Tokenizer"
    },
    "sap.m.Tokenizer-aggregations": {
        "prefix": "!5-sap-m-tokenizer",
        "body": [
            "<m:Tokenizer>",
            "\t<m:Token>",
            "\t\t$1",
            "\t</m:Token>",
            "</m:Tokenizer>"
        ],
        "description": "sap.m.Tokenizer"
    },
    "sap.m.Tokenizer-events": {
        "prefix": "!5-sap-m-tokenizer",
        "body": [
            "<m:Tokenizer",
            "\ttokenChange=\".onTokenChange\"",
            "\ttokenUpdate=\".onTokenUpdate\"",
            "\ttokenDelete=\".onTokenDelete\"",
            "\trenderModeChange=\".onRenderModeChange\"",
            "\t$1",
            "/>"
        ],
        "description": "sap.m.Tokenizer"
    },
    "sap.m.Tokenizer-all": {
        "prefix": "!5-sap-m-tokenizer",
        "body": [
            "<m:Tokenizer",
            "\teditable=\"true\"",
            "\tenabled=\"true\"",
            "\twidth=\"null\"",
            "\tmaxWidth=\"100%\"",
            "\trenderMode=\"sap.m.TokenizerRenderMode.Narrow\"",
            "\ttokenChange=\".onTokenChange\"",
            "\ttokenUpdate=\".onTokenUpdate\"",
            "\ttokenDelete=\".onTokenDelete\"",
            "\trenderModeChange=\".onRenderModeChange\"",
            ">",
            "\t<tokens>",
            "\t\t<m:Token",
            "\t\t\t$1",
            "\t\t/>",
            "\t</tokens>",
            "</m:Tokenizer>"
        ],
        "description": "sap.m.Tokenizer"
    }
}
