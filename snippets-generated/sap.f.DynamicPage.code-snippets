        "body": [
            "<f:DynamicPage",
            "\tpreserveHeaderStateOnScroll=\"false\"",
            "\theaderExpanded=\"true\"",
            "\theaderPinned=\"false\"",
            "\ttoggleHeaderOnTitleClick=\"true\"",
            "\tshowFooter=\"false\"",
            "\tbackgroundDesign=\"Standard\"",
            "\tfitContent=\"false\"",
            "$1/>"
