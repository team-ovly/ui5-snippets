            "\t\t$5",
            "\t</f:DynamicPageAccessibleLandmarkInfo>",
            "</f:DynamicPage>"
        ],
        "description": "sap.f.DynamicPage"
    },
    "sap.f.DynamicPage-events": {
        "prefix": "!5-sap-f-dynamicpage",
        "body": [
            "<f:DynamicPage",
            "\tpinnedStateChange=\".onPinnedStateChange\"",
            "\t$1",
            "/>"
        ],
        "description": "sap.f.DynamicPage"
    },
