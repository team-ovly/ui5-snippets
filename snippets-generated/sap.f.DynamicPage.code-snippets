        "body": [
            "<f:DynamicPage>",
            "\t<f:DynamicPageTitle>",
            "\t\t$1",
            "\t</f:DynamicPageTitle>",
            "\t<f:DynamicPageHeader>",
            "\t\t$2",
            "\t</f:DynamicPageHeader>",
            "\t<core:Control>",
            "\t\t$3",
            "\t</core:Control>",
            "\t<m:IBar>",
            "\t\t$4",
