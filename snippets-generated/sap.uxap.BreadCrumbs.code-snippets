{
    "sap.uxap.BreadCrumbs": {
        "prefix": "!5-sap-uxap-breadcrumbs",
        "body": [
            "<uxap:BreadCrumbs ",
            "\t$1",
            "\t/>"
        ],
        "description": "sap.uxap.BreadCrumbs"
    },
    "sap.uxap.BreadCrumbs-properties": {
        "prefix": "!5-sap-uxap-breadcrumbs",
        "body": [
            "<uxap:BreadCrumbs",
            "\tshowCurrentLocation=\"true\"",
            "$1/>"
        ],
        "description": "sap.uxap.BreadCrumbs"
    },
    "sap.uxap.BreadCrumbs-aggregations": {
        "prefix": "!5-sap-uxap-breadcrumbs",
        "body": [
            "<uxap:BreadCrumbs>",
            "\t<m:Link>",
            "\t\t$1",
            "\t</m:Link>",
            "\t<m:Text>",
            "\t\t$2",
            "\t</m:Text>",
            "</uxap:BreadCrumbs>"
        ],
        "description": "sap.uxap.BreadCrumbs"
    },
    "sap.uxap.BreadCrumbs-events": {
        "prefix": "!5-sap-uxap-breadcrumbs",
        "body": [
            "<uxap:BreadCrumbs",
            "\t$1",
            "/>"
        ],
        "description": "sap.uxap.BreadCrumbs"
    },
    "sap.uxap.BreadCrumbs-all": {
        "prefix": "!5-sap-uxap-breadcrumbs",
        "body": [
            "<uxap:BreadCrumbs",
            "\tshowCurrentLocation=\"true\"",
            ">",
            "\t<links>",
            "\t\t<m:Link",
            "\t\t\t$1",
            "\t\t/>",
            "\t</links>",
            "\t<currentLocation>",
            "\t\t<m:Text",
            "\t\t\t$2",
            "\t\t/>",
            "\t</currentLocation>",
            "</uxap:BreadCrumbs>"
        ],
        "description": "sap.uxap.BreadCrumbs"
    }
}
