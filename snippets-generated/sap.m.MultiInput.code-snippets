{
    "sap.m.MultiInput": {
        "prefix": "!5-sap-m-multiinput",
        "body": [
            "<m:MultiInput ",
            "\t$1",
            "\t/>"
        ],
        "description": "sap.m.MultiInput"
    },
    "sap.m.MultiInput-properties": {
        "prefix": "!5-sap-m-multiinput",
        "body": [
            "<m:MultiInput",
            "\tenableMultiLineMode=\"false\"",
            "\tmaxTokens=\"null\"",
            "\tshowSuggestion=\"true\"",
            "$1/>"
        ],
        "description": "sap.m.MultiInput"
    },
    "sap.m.MultiInput-aggregations": {
        "prefix": "!5-sap-m-multiinput",
        "body": [
            "<m:MultiInput>",
            "\t<m:Token>",
            "\t\t$1",
            "\t</m:Token>",
            "</m:MultiInput>"
        ],
        "description": "sap.m.MultiInput"
    },
    "sap.m.MultiInput-events": {
        "prefix": "!5-sap-m-multiinput",
        "body": [
            "<m:MultiInput",
            "\ttokenChange=\".onTokenChange\"",
            "\ttokenUpdate=\".onTokenUpdate\"",
            "\t$1",
            "/>"
        ],
        "description": "sap.m.MultiInput"
    },
    "sap.m.MultiInput-all": {
        "prefix": "!5-sap-m-multiinput",
        "body": [
            "<m:MultiInput",
            "\tenableMultiLineMode=\"false\"",
            "\tmaxTokens=\"null\"",
            "\tshowSuggestion=\"true\"",
            "\ttokenChange=\".onTokenChange\"",
            "\ttokenUpdate=\".onTokenUpdate\"",
            ">",
            "\t<tokens>",
            "\t\t<m:Token",
            "\t\t\t$1",
            "\t\t/>",
            "\t</tokens>",
            "</m:MultiInput>"
        ],
        "description": "sap.m.MultiInput"
    }
}
