{
    "sap.m.ActionSheet": {
        "prefix": "!5-sap-m-actionsheet",
        "body": [
            "<m:ActionSheet ",
            "\t$1",
            "\t/>"
        ],
        "description": "sap.m.ActionSheet"
    },
    "sap.m.ActionSheet-properties": {
        "prefix": "!5-sap-m-actionsheet",
        "body": [
            "<m:ActionSheet",
            "\tplacement=\"Bottom\"",
            "\tshowCancelButton=\"true\"",
            "\tcancelButtonText=\"null\"",
            "\ttitle=\"null\"",
            "$1/>"
        ],
        "description": "sap.m.ActionSheet"
    },
    "sap.m.ActionSheet-aggregations": {
        "prefix": "!5-sap-m-actionsheet",
        "body": [
            "<m:ActionSheet>",
            "\t<m:Button>",
            "\t\t$1",
            "\t</m:Button>",
            "</m:ActionSheet>"
        ],
        "description": "sap.m.ActionSheet"
    },
    "sap.m.ActionSheet-events": {
        "prefix": "!5-sap-m-actionsheet",
        "body": [
            "<m:ActionSheet",
            "\tcancelButtonTap=\".onCancelButtonTap\"",
            "\tbeforeOpen=\".onBeforeOpen\"",
            "\tafterOpen=\".onAfterOpen\"",
            "\tbeforeClose=\".onBeforeClose\"",
            "\tafterClose=\".onAfterClose\"",
            "\tcancelButtonPress=\".onCancelButtonPress\"",
            "\t$1",
            "/>"
        ],
        "description": "sap.m.ActionSheet"
    },
    "sap.m.ActionSheet-all": {
        "prefix": "!5-sap-m-actionsheet",
        "body": [
            "<m:ActionSheet",
            "\tplacement=\"Bottom\"",
            "\tshowCancelButton=\"true\"",
            "\tcancelButtonText=\"null\"",
            "\ttitle=\"null\"",
            "\tcancelButtonTap=\".onCancelButtonTap\"",
            "\tbeforeOpen=\".onBeforeOpen\"",
            "\tafterOpen=\".onAfterOpen\"",
            "\tbeforeClose=\".onBeforeClose\"",
            "\tafterClose=\".onAfterClose\"",
            "\tcancelButtonPress=\".onCancelButtonPress\"",
            ">",
            "\t<buttons>",
            "\t\t<m:Button",
            "\t\t\t$1",
            "\t\t/>",
            "\t</buttons>",
            "</m:ActionSheet>"
        ],
        "description": "sap.m.ActionSheet"
    }
}
