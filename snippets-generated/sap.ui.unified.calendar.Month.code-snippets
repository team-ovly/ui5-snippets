        "prefix": "!5-sap-ui-unified-calendar-month",
        "body": [
            "<calendar:Month",
            "\tdate=\"null\"",
            "\tintervalSelection=\"false\"",
            "\tsingleSelection=\"true\"",
            "\tshowHeader=\"false\"",
            "\tfirstDayOfWeek=\"-1\"",
            "\tnonWorkingDays=\"null\"",
            "\tprimaryCalendarType=\"null\"",
            "\tsecondaryCalendarType=\"null\"",
            "\twidth=\"null\"",
            "\tshowWeekNumbers=\"true\"",
            "\tcalendarWeekNumbering=\"null\"",
            "$1/>"
        ],
        "description": "sap.ui.unified.calendar.Month"
    },
    "sap.ui.unified.calendar.Month-aggregations": {
        "prefix": "!5-sap-ui-unified-calendar-month",
        "body": [
            "<calendar:Month>",
            "\t<unified:DateRange>",
            "\t\t$1",
            "\t</unified:DateRange>",
            "\t<unified:DateTypeRange>",
            "\t\t$2",
            "\t</unified:DateTypeRange>",
            "\t<unified:DateRange>",
            "\t\t$3",
            "\t</unified:DateRange>",
            "</calendar:Month>"
        ],
        "description": "sap.ui.unified.calendar.Month"
    },
    "sap.ui.unified.calendar.Month-events": {
        "prefix": "!5-sap-ui-unified-calendar-month",
        "body": [
            "<calendar:Month",
            "\tselect=\".onSelect\"",
            "\tfocus=\".onFocus\"",
            "\tweekNumberSelect=\".onWeekNumberSelect\"",
            "\t$1",
            "/>"
        ],
        "description": "sap.ui.unified.calendar.Month"
    },
    "sap.ui.unified.calendar.Month-all": {
        "prefix": "!5-sap-ui-unified-calendar-month",
        "body": [
            "<calendar:Month",
            "\tdate=\"null\"",
            "\tintervalSelection=\"false\"",
            "\tsingleSelection=\"true\"",
            "\tshowHeader=\"false\"",
            "\tfirstDayOfWeek=\"-1\"",
            "\tnonWorkingDays=\"null\"",
            "\tprimaryCalendarType=\"null\"",
            "\tsecondaryCalendarType=\"null\"",
            "\twidth=\"null\"",
            "\tshowWeekNumbers=\"true\"",
            "\tcalendarWeekNumbering=\"null\"",
            "\tselect=\".onSelect\"",
            "\tfocus=\".onFocus\"",
            "\tweekNumberSelect=\".onWeekNumberSelect\"",
            ">",
            "\t<selectedDates>",
            "\t\t<unified:DateRange",
            "\t\t\t$1",
            "\t\t/>",
            "\t</selectedDates>",
            "\t<specialDates>",
            "\t\t<unified:DateTypeRange",
            "\t\t\t$2",
            "\t\t/>",
            "\t</specialDates>",
            "\t<disabledDates>",
            "\t\t<unified:DateRange",
            "\t\t\t$3",
            "\t\t/>",
            "\t</disabledDates>",
            "</calendar:Month>"
        ],
        "description": "sap.ui.unified.calendar.Month"
    }
}
