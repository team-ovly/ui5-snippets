{
    "name": "ovly-ui5-snippets",
    "displayName": "ovly-ui5-snippets",
    "description": "SAPUI5 snippets by OVLY",
    "repository": {
        "url": "https://github.com/team-ovly/ui5-snippets"
    },
    "publisher": "OVLY",
    "version": "0.0.4",
    "engines": {
        "vscode": "^1.52.0"
    },
    "categories": [
        "Snippets"
    ],
    "dependencies": {
        "@ui5/dts-generator": "^4.0.5"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    },
    "scripts": {
        "generate": "node ./generator/index.js",
        "download": "node ./generator/download.js",
        "watch:generate": "nodemon --watch ./generator --exec \"npm run generate\"",
        "watch:download": "nodemon --watch ./generator --exec \"npm run download\""
    },
    "contributes": {
        "snippets": [
            {
                "language": "javascript",
                "path": "./snippets-handwritten/component/app-component.code-snippets"
            },
            {
                "language": "json",
                "path": "./snippets-handwritten/descriptor/app-manifest-1.71.code-snippets"
            },
            {
                "language": "html",
                "path": "./snippets-handwritten/index/bootstrap.code-snippets"
            },
            {
                "language": "xml",
                "path": "./snippets-handwritten/sap.m/Input.code-snippets"
            },
            {
                "language": "xml",
                "path": "./snippets-handwritten/sap.ui.core/View.xml.code-snippets"
            },
            {
                "language": "javascript",
                "path": "./snippets-handwritten/sap.ui.model.odata.v2/ODataModel.code-snippets"
            },
            {
                "language": "javascript",
                "path": "./snippets-handwritten/controller/controller.code-snippets"
            },
            {
                "language": "javascript",
                "path": "./snippets-handwritten/controller/controller-dependency.code-snippets"
            }
        ]
    }
}
